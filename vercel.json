{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build -w @cmyk/shared && npm run build -w @cmyk/api && npm run build -w @cmyk/web",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{profiles/**,apps/api/dist/**,packages/shared/dist/**,node_modules/@cmyk/**}"
    }
  }
}
